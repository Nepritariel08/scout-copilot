{
  "version": 1,
  "deploymentId": "scout-owned-pilot",
  "globalMaxConcurrent": 2,
  "globalMaxCallsPerDay": 100,
  "bindings": [
    {
      "userId": "synthetic-native-subject",
      "tenantId": "synthetic-tenant",
      "active": true,
      "revision": 1,
      "expiresAt": "2026-12-01T00:00:00Z",
      "agentIds": ["scout"],
      "allowConversationContext": true,
      "allowPersonalInstructions": false,
      "route": {
        "provider": "openrouter",
        "model": "openrouter/free",
        "apiKeyFile": "/etc/scout/private/openrouter.key"
      },
      "limits": {
        "maxInputBytes": 16384,
        "maxOutputTokens": 256,
        "maxOutputBytes": 16384,
        "maxCallsPerRun": 1,
        "maxCallsPerDay": 20,
        "maxConcurrent": 1,
        "timeoutMs": 30000
      }
    }
  ]
}
