# Incomplete owned-mode overlay. Secrets and policy stay outside Git.
# Private pilot configuration; source qualification is separate from deployment.
SCOUT_RUNTIME_MODE=owned
TENANT_PACKAGE_DIR=../examples/scout
DEPLOYMENT_ID=scout-owned-pilot
OPENBOT_HOST=127.0.0.1
OPENBOT_SINGLE_USER=false
OPENBOT_DEV_NO_AUTH=false
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
OPENBOT_OTEL_EXPORT=off
OPENBOT_LEARNING_AUTO_ASSIGN=false
OPENBOT_SELF_HOST_BANNER=false
OPENBOT_GENERATIVE_UI=false

# Dedicated database/key, verified sign-in and current per-user tenant/requester
# policy are required. Supply them through the protected deployment environment.
DATABASE_URL=
KEY_ENCRYPTION_KEY=
OPENBOT_ORGANIZATION_AUTH_URL=
OPENBOT_PUBLIC_URL=
SCOUT_QUEUE_BINDINGS_FILE=
SCOUT_MODEL=
SCOUT_MODEL_POLICY_FILE=

# No Intelligence credentials are required in owned mode. The licensed mode is
# the default when SCOUT_RUNTIME_MODE is unset. Use production-entry.ts; start.sh
# refuses owned mode because it owns the upstream routines worker/computers.
