# Incomplete owned-mode overlay. Secrets and policy stay outside Git.
# Private pilot configuration; source qualification is separate from deployment.
SCOUT_RUNTIME_MODE=owned
TENANT_PACKAGE_DIR=../examples/scout
DEPLOYMENT_ID=scout-owned-pilot
OPENBOT_HOST=127.0.0.1
OPENBOT_SINGLE_USER=false
OPENBOT_DEV_NO_AUTH=false
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
OPENBOT_OTEL_EXPORT=off
OPENBOT_LEARNING_AUTO_ASSIGN=false
OPENBOT_SELF_HOST_BANNER=false
OPENBOT_GENERATIVE_UI=false

# Dedicated database/key, verified sign-in and current per-user native membership
# policy are required. Supply them through the protected deployment environment.
DATABASE_URL=
KEY_ENCRYPTION_KEY=
OPENBOT_ORGANIZATION_AUTH_URL=
OPENBOT_PUBLIC_URL=
SCOUT_MEMBERSHIPS_FILE=
SCOUT_MODEL=
SCOUT_MODEL_POLICY_FILE=
# Optional protected JSON source settings for the read-only project.task adapter.
# Keep the source-instance id, HTTPS base URL and database in this file; never
# put user IDs, Odoo API keys, company/project grants, or customer mappings in it.
# No grants are issued by this adapter; without separately verified active
# grants, selected-record context remains denied. Linux runtime only; the
# adapter refuses other platforms until source-file ACLs are enforced. See OWNED-MODEL.md.
SCOUT_ODOO_CONTEXT_SOURCE_FILE=
# Separate optional protected user/tenant/deployment/source UID/company mapping.
# No API key or queue process fields; active membership alone grants no Odoo access.
SCOUT_ODOO_BINDINGS_FILE=

# Microsoft Entra native login for staff and explicitly invited customer guests.
# Owned mode requires one exact resource-tenant GUID and no alternate social provider.
# See OWNED-ENTRA.md. Register this exact Better Auth callback with the Entra app.
BETTER_AUTH_URL=https://scout.somethingsomewhere.ph
TRUSTED_ORIGINS=https://scout.somethingsomewhere.ph
# Supply client values and a >=32-character native session secret only through
# the protected deployment environment. No credential is supplied by this file.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
BETTER_AUTH_SECRET=
# Required exact operator-approved email(s); identity is preprovisioned through
# the immutable resource-tenant (tid, oid) account mapping described in the guide.
# Native email-based admin seeding does not grant platform ownership or a tenant.
INITIAL_ADMIN_EMAILS=
# Leave OPENBOT_ORGANIZATION_AUTH_URL empty for this native Entra route.

# Comma-separated EXACT verified native subject IDs, not email addresses/roles.
# Each owner also needs its native admin role and current protected membership.
# Empty means no platform administration; other native admins become owned users.
# Global people/credential/audit/SSO control is not tenant-admin permission.
# At most 100 unique IDs, each <=200 characters without ASCII spaces/control bytes.
SCOUT_PLATFORM_OWNER_IDS=

# Enable only after the deployed queue's Scout provenance and live contract pass.
# This is independent of model inference; default false prevents queue dispatch.
SCOUT_DELEGATED_DRAFTS_ENABLED=false
# Required only when delegated drafts are enabled; never grants native membership.
SCOUT_QUEUE_BINDINGS_FILE=
# See MEMBERSHIP.md for mandatory migration from the former queue-derived admission.

# No Intelligence credentials are required in owned mode. The licensed mode is
# the default when SCOUT_RUNTIME_MODE is unset. Use production-entry.ts; start.sh
# refuses owned mode because it owns the upstream routines worker/computers.
# Apply the owned schema/resource scopes; unscoped legacy resources are denied.
# All seven SSO management endpoints require exact platform ownership. Auth-admin,
# SCIM and bearer-only remote callbacks remain unavailable pending adaptation.
# Keep the existing 8GB Linode; measure before any resize. MatePad inference and
# native execution require actual device qualification, not just route settings.
