# Overlay on openbot/.env.example; this file is not a complete runnable deployment.
# Required secrets and endpoints stay blank until a private pilot is qualified.
TENANT_PACKAGE_DIR=../examples/scout
DEPLOYMENT_ID=scout-owner-qualification
COMPOSE_PROJECT_NAME=scout-owner-qualification
COMPUTER_NAMESPACE=scout-owner-qualification
OPENBOT_HOST=127.0.0.1
OPENBOT_SINGLE_USER=false
OPENBOT_DEV_NO_AUTH=false
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
OPENBOT_OTEL_EXPORT=off
OPENBOT_LEARNING_AUTO_ASSIGN=false

# OpenRouter uses the OpenAI-compatible protocol. A qualified budget/policy
# proxy may replace this URL. No direct-provider key is stored in source.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
SCOUT_MODEL=
BOT_MODEL=
BOT_PROVIDER=openai
BOT_RESPONSES_API=false

# Set both URLs to the SAME approved hosted or licensed self-hosted installation.
# Leaving these blank deliberately refuses startup. No silent hosted fallback.
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
INTELLIGENCE_API_KEY=
CPK_INTELLIGENCE_API_KEY=

# Database, encryption key, identity provider, authenticated public origin and
# cookie/session secret must be supplied separately. Do not run start.sh with
# upstream single-user defaults on a shared network. Do not start a second DSH
# scheduler or expose the existing owner requester credential to other users.
